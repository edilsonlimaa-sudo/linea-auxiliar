# Copia este archivo a .env.local. Valores del Supabase LOCAL (npm run db:start los muestra).
# En producción se reemplazan por los del proyecto en supabase.com.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Solo para scripts del servidor (npm run admin:crear). Nunca con prefijo NEXT_PUBLIC_.
# Local: la muestra "npm run db:start" (SECRET_KEY). Producción: Supabase → Project Settings → API Keys.
SUPABASE_SECRET_KEY=
# ADMIN_USUARIO=admin
# ADMIN_CLAVE=            # obligatoria en producción

# Solo para npm run db:nube (aplicar migraciones en la nube por la API, sin la CLI). Token personal:
# supabase.com/dashboard/account/tokens. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_ACCESS_TOKEN=
# Proyecto de la nube para db:nube (el <ref> de https://<ref>.supabase.co). Opcional si la CLI ya está vinculada
# (supabase/.temp/project-ref); el app local apunta al Docker, así que la URL de arriba no sirve para esto.
# SUPABASE_PROJECT_REF=
